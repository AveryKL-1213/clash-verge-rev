--- /dev/null
+++ b/local_policy_test.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"flag"
+	"io"
+	"testing"
+)
+
+func localPolicyFlagSet() *flag.FlagSet {
+	flags := flag.NewFlagSet("local-policy-test", flag.ContinueOnError)
+	flags.SetOutput(io.Discard)
+	registerLocalFlags(flags)
+	return flags
+}
+
+func TestLocalPolicyIgnoresInheritedStartupOverrides(t *testing.T) {
+	for _, name := range []string{
+		"CLASH_HOME_DIR", "CLASH_CONFIG_FILE", "CLASH_CONFIG_STRING",
+		"CLASH_AGE_SECRET_KEY", "CLASH_OVERRIDE_EXTERNAL_UI_DIR",
+		"CLASH_OVERRIDE_EXTERNAL_CONTROLLER", "CLASH_OVERRIDE_EXTERNAL_CONTROLLER_TLS",
+		"CLASH_OVERRIDE_EXTERNAL_CONTROLLER_UNIX", "CLASH_OVERRIDE_EXTERNAL_CONTROLLER_PIPE",
+		"CLASH_OVERRIDE_SECRET", "CLASH_POST_UP", "CLASH_POST_DOWN",
+	} {
+		t.Setenv(name, "untrusted-inherited-value")
+	}
+	t.Setenv("CLASH_OVERRIDE_EXTERNAL_CONTROLLER_ROUTING_MARK", "42")
+	flags := localPolicyFlagSet()
+	if err := flags.Parse(nil); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{
+		"d", "f", "config", "age-secret-key", "ext-ui", "ext-ctl",
+		"ext-ctl-tls", "ext-ctl-unix", "ext-ctl-pipe", "secret",
+	} {
+		if value := flags.Lookup(name).Value.String(); value != "" {
+			t.Fatalf("inherited environment changed %q to %q", name, value)
+		}
+	}
+	if externalControllerRoutingMark != 0 {
+		t.Fatal("inherited environment changed the controller routing mark")
+	}
+}
+
+func TestLocalPolicyPreservesExplicitConfigAndIPCFlags(t *testing.T) {
+	flags := localPolicyFlagSet()
+	if err := flags.Parse([]string{
+		"-d", "/policy-test/profile", "-f", "/policy-test/config.yaml",
+		"-ext-ctl-unix", "/policy-test/controller.sock", "-t",
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if homeDir != "/policy-test/profile" || configFile != "/policy-test/config.yaml" ||
+		externalControllerUnix != "/policy-test/controller.sock" || !testConfig {
+		t.Fatal("explicit profile, config, IPC or test flags were not preserved")
+	}
+}
+
+func TestLocalPolicyRejectsShellHookFlags(t *testing.T) {
+	for _, name := range []string{"post-up", "post-down"} {
+		for _, prefix := range []string{"-", "--"} {
+			flags := localPolicyFlagSet()
+			if flags.Lookup(name) != nil {
+				t.Fatalf("shell hook %q is still registered", name)
+			}
+			if err := flags.Parse([]string{prefix + name, "must-not-run"}); err == nil {
+				t.Fatalf("shell hook %q was accepted", prefix+name)
+			}
+		}
+	}
+}
