+++ b/constant/local_policy_test.go
@@ -0,0 +1,24 @@
+package constant
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalPolicyRejectsEnvironmentPathExpansion(t *testing.T) {
+	directory := t.TempDir()
+	profile := filepath.Join(directory, "profile")
+	outside := filepath.Join(directory, "outside")
+	t.Setenv("SKIP_SAFE_PATH_CHECK", "true")
+	t.Setenv("SAFE_PATHS", outside)
+	local := newLocalPath(profile)
+	if local.allowUnsafePath || len(local.safePaths) != 0 {
+		t.Fatal("inherited environment weakened the local path policy")
+	}
+	if local.IsSafePath(filepath.Join(outside, "core")) || local.IsSafePath("../outside/core") {
+		t.Fatal("an outside path was accepted")
+	}
+	if !local.IsSafePath("rules/local.yaml") || !local.IsSafePath(filepath.Join(profile, "config.yaml")) {
+		t.Fatal("valid files inside the configured profile were rejected")
+	}
+}
