+++ b/component/updater/local_policy.go
@@ -0,0 +1,11 @@
+package updater
+
+import "errors"
+
+// ErrLocalArtifactUpdatesDisabled keeps this local build on its audited artifacts.
+// Updating binaries or dashboard code requires a new offline local release.
+var ErrLocalArtifactUpdatesDisabled = errors.New("artifact downloads are disabled in this local build; install a new local release")
+
+func enforceLocalArtifactPolicy() error {
+	return ErrLocalArtifactUpdatesDisabled
+}
diff --git a/component/updater/local_policy_test.go b/component/updater/local_policy_test.go
new file mode 100644
index 0000000..78f52af
--- /dev/null
+++ b/component/updater/local_policy_test.go
@@ -0,0 +1,46 @@
+package updater
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalPolicyRejectsArtifactDownloads(t *testing.T) {
+	directory := t.TempDir()
+	core := filepath.Join(directory, "core")
+	original := []byte("local source-built core fixture")
+	if err := os.WriteFile(core, original, 0o700); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, channel := range []string{"", ReleaseChannel, AlphaChannel} {
+		err := DefaultCoreUpdater.Update(core, channel, true)
+		if !errors.Is(err, ErrLocalArtifactUpdatesDisabled) {
+			t.Fatalf("channel %q: expected local policy rejection, got %v", channel, err)
+		}
+	}
+	// Policy rejection also precedes checking or replacing the current binary.
+	if err := DefaultCoreUpdater.Update(filepath.Join(directory, "absent"), ReleaseChannel, false); !errors.Is(err, ErrLocalArtifactUpdatesDisabled) {
+		t.Fatalf("expected policy rejection for absent executable, got %v", err)
+	}
+	data, err := os.ReadFile(core)
+	if err != nil || string(data) != string(original) {
+		t.Fatalf("the local executable changed: %q, %v", data, err)
+	}
+
+	ui := &UIUpdater{
+		externalUIPath: filepath.Join(directory, "ui"),
+		externalUIURL:  "://invalid-policy-test-url",
+		autoDownloadUI: true,
+	}
+	if err := ui.DownloadUI(); !errors.Is(err, ErrLocalArtifactUpdatesDisabled) {
+		t.Fatalf("expected UI policy rejection before URL parsing, got %v", err)
+	}
+	ui.AutoDownloadUI()
+	entries, err := os.ReadDir(directory)
+	if err != nil || len(entries) != 1 || entries[0].Name() != "core" {
+		t.Fatalf("artifact updates created unexpected files: %v, %v", entries, err)
+	}
+}
